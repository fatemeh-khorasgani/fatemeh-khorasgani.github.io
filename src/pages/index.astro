---
const year = new Date().getFullYear();

const projects = [
  {
    number: "01",
    href: "/projects/carbon-feedback/",
    title: "Personalized Carbon Feedback",
    question: "Can personalized behavioral feedback help people make lower-carbon choices?",
    summary:
      "A randomized, two-wave study of 752 adults in Atlantic Canada testing a tailored digital intervention designed to support lower-carbon choices.",
    contribution:
      "Co-designed the study and intervention, collected and analyzed the data, co-wrote the manuscript, and built the personalized carbon-footprint calculator in Qualtrics using custom JavaScript.",
    methods: ["Randomized experiment", "Qualtrics", "Mixed ANOVA", "Sensitivity analysis"],
    status: "Co-first-author manuscript in preparation",
  },
  {
    number: "02",
    href: "/projects/eco-anxiety-well-being/",
    title: "Eco-Anxiety & Adolescent Well-Being",
    question: "How is eco-anxiety related to well-being during early adolescence, and can environmental resources buffer that relationship?",
    summary:
      "A three-wave longitudinal study of 154 sixth-grade students examining eco-anxiety, psychological well-being, and potential protective factors.",
    contribution:
      "Developed the research questions, analyzed the data, evaluated measurement quality using confirmatory factor analysis, modeled between- and within-person associations and moderation, and prepared the first-author manuscript.",
    methods: ["R (Programming Language)", "Multilevel modeling", "CFA", "Longitudinal analysis"],
    status: "First-author manuscript under review",
  },
  {
    number: "03",
    href: "/projects/immigrant-commitment/",
    title: "Immigrant Commitment & System Attitudes",
    question: "What helps people feel committed to building a future in a new country?",
    summary:
      "An online study of Iranian immigrants across Canada examining how satisfaction, social and financial investments, perceived alternatives, and attitudes toward Canadian society relate to commitment.",
    contribution:
      "Designed and preregistered the study, recruited a hard-to-reach population, adapted and evaluated psychological measures, managed data quality, conducted exploratory factor and hierarchical regression analyses, and wrote the manuscript. The primary model explained 64.5% of the variance in commitment to Canada.",
    methods: ["Preregistration", "EFA", "Regression", "Community recruitment"],
    status: "First-author manuscript in preparation",
  },
  {
    number: "04",
    href: "/projects/peer-contexts/",
    title: "Climate Anxiety in Peer Contexts",
    question: "Do similarities in adolescents’ climate anxiety reflect peer influence, social selection, or shared experiences?",
    summary:
      "A three-wave study combining repeated surveys and peer-nomination data to examine how climate anxiety develops within adolescent peer networks.",
    contribution:
      "Developed the research questions, integrated longitudinal survey and peer-nomination data, derived peer-exposure measures, and used mixed-effects and lagged models in R to compare peer-influence, social-selection, and shared-context explanations. Adapted the analytic strategy to accommodate changing participation across waves.",
    methods: ["R (Programming Language)", "Peer-derived variables", "Lagged models", "Mixed effects"],
    status: "Analysis and manuscript in development",
  },
];

const capabilities = [
  {
    title: "Research design",
    text: "Randomized experiments, longitudinal studies, surveys, mixed-methods research, program evaluation, preregistration, and psychometrics.",
  },
  {
    title: "Quantitative analysis",
    text: "Multilevel models, between-/within-person decomposition, CFA/EFA, regression, moderation, mixed ANOVA, lagged models, and robustness checks.",
  },
  {
    title: "Qualitative & applied research",
    text: "Focus groups, semi-structured interviews, thematic analysis, stakeholder engagement, environmental scans, and actionable reporting.",
  },
  {
    title: "Tools",
    text: "R, Python, SQL, SPSS, Jamovi, Git/GitHub, LaTeX, Qualtrics, and custom JavaScript integration within Qualtrics.",
  },
];

const experience = [
  {
    role: "Graduate Research Assistant",
    organization: "University of Oregon",
    dates: "2025–Present",
    description:
      "Conduct longitudinal research on adolescent development, climate-related emotions, well-being, peer contexts, and decision-making; lead analyses in R and develop first-author manuscripts.",
  },
  {
    role: "Graduate Research Assistant",
    organization: "Societal Cognition Lab · Memorial University",
    dates: "2023–2025",
    description:
      "Designed and preregistered research on immigrant commitment and system attitudes, programmed studies in Qualtrics, recruited a specialized community sample, and conducted psychometric and regression analyses.",
  },
  {
    role: "Graduate Assistant · Program Evaluation",
    organization: "Career Integrated Learning · Memorial University",
    dates: "2025",
    description:
      "Developed analysis plans for university intervention evaluations and translated quantitative and qualitative evidence into stakeholder reports and presentations.",
  },
  {
    role: "Research Intern",
    organization: "Centre for Collaborative Health Professional Education",
    dates: "2025",
    description:
      "Designed and facilitated focus groups, analyzed learner feedback, conducted thematic analysis, and supported curriculum and program development.",
  },
  {
    role: "Research Intern",
    organization: "Memorial University & Net Zero Atlantic",
    dates: "2024",
    description:
      "Co-designed a randomized behavioral intervention, built a personalized carbon calculator, analyzed outcomes, and contributed to research- and policy-oriented outputs.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Psychology PhD student and quantitative behavioral researcher with experience in longitudinal studies, randomized experiments, survey design, psychometrics, mixed-methods evaluation, R, and Qualtrics."
    />
    <meta name="theme-color" content="#0b3b49" />
    <title>Fatemeh Ghazavi Khorasgani | Quantitative Behavioral Researcher</title>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header">
      <div class="nav-shell">
        <a class="brand" href="#top" aria-label="Fatemeh Ghazavi Khorasgani, home">
          <span class="brand-mark" aria-hidden="true">FGK</span>
          <span class="brand-name">Fatemeh Ghazavi Khorasgani</span>
        </a>

        <nav aria-label="Primary navigation">
          <a href="#about">About</a>
          <a href="#projects">Projects</a>
          <a href="#methods">Methods</a>
          <a href="#experience">Experience</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="top">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="hero-grid-pattern" aria-hidden="true"></div>
        <div class="page-shell hero-grid">
          <div class="hero-copy">
            <div class="hero-intro-line">
              <p class="eyebrow">Psychology PhD · Quantitative Behavioral Research</p>
              <div class="availability">
                <span class="availability-dot" aria-hidden="true"></span>
                Available Summer 2027
              </div>
            </div>

            <h1>Behavior makes more sense <em>in context.</em></h1>
            <p class="hero-lede">
              I use experiments, longitudinal data, and mixed methods to understand how
              people respond to uncertainty, social environments, and behavioral
              interventions—and turn the evidence into useful decisions.
            </p>

            <div class="hero-actions">
              <a class="button button-primary" href="#projects">Explore selected work <span aria-hidden="true">↓</span></a>
              <a class="button button-secondary" href="/resume.pdf" download>Download CV <span aria-hidden="true">↗</span></a>
            </div>

            <p class="role-focus">
              Seeking roles in Quantitative UX Research · Behavioral Science · Product Research · Research Science
            </p>

          </div>

          <aside class="portrait-stage" aria-label="Fatemeh Ghazavi Khorasgani and research highlights">
            <div class="portrait-frame">
              <img
                src="/images/fatemeh-profile.jpeg"
                alt="Fatemeh Ghazavi Khorasgani"
                width="435"
                height="600"
                loading="eager"
                fetchpriority="high"
              />
              <div class="portrait-caption">
                <strong>Fatemeh Ghazavi Khorasgani</strong>
                <span>Psychology PhD Student · University of Oregon</span>
              </div>
            </div>

            <div class="portrait-ribbon" aria-hidden="true">
              Behavior <span>×</span> Context
            </div>

            <div class="floating-stat floating-stat-one">
              <strong>1,000+</strong>
              <span>participants in a randomized intervention</span>
            </div>
            <div class="floating-stat floating-stat-two">
              <strong>3 waves</strong>
              <span>of longitudinal data</span>
            </div>
          </aside>
        </div>
      </section>

      <section class="proof-strip" aria-label="Core research strengths">
        <div class="page-shell proof-grid">
          <span>Longitudinal research</span>
          <span>Randomized experiments</span>
          <span>Survey & psychometric research</span>
          <span>Mixed-methods evaluation</span>
        </div>
      </section>

      <section class="section page-shell about-grid" id="about">
        <div>
          <p class="section-label">About</p>
          <h2>Rigorous methods, applied to consequential questions.</h2>
        </div>

        <div class="about-copy">
          <p>
            I am a Psychology PhD student at the University of Oregon. My
            research asks how individual and social contexts shape decisions, behavior,
            and well-being—and how behavioral evidence can improve products, programs,
            and interventions.
          </p>
          <p>
            My experience spans longitudinal studies, randomized experiments, survey
            design, psychometrics, program evaluation, and mixed-methods research. I
            enjoy taking a question from initial design through data collection,
            analysis, interpretation, and communication.
          </p>
          <p>
            I have worked with adolescents, immigrants, adult panel participants,
            students, educators, health-professional learners, nonprofit partners, and
            public advisors. Across these settings, I focus on making complex evidence
            accurate, understandable, and useful.
          </p>
        </div>
      </section>

      <section class="section section-tinted" id="projects">
        <div class="page-shell">
          <div class="section-heading">
            <div>
              <p class="section-label">Selected projects</p>
              <h2>Research designed to explain and improve real-world outcomes.</h2>
            </div>
            <p>
              Four selected projects showing experimental design, longitudinal analysis,
              psychometrics, mixed methods, and research judgment.
            </p>
          </div>

          <div class="project-grid">
            {
              projects.map((project) => (
                <a
                  class="project-link"
                  href={project.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${project.title} case study (opens in a new tab)`}
                >
                <article class="project-card">
                  <div class="project-topline">
                    <span class="project-number">{project.number}</span>
                    <span class="project-status">{project.status}</span>
                  </div>
                  <h3>{project.title}</h3>
                  <p class="project-question">{project.question}</p>
                  <p>{project.summary}</p>
                  <div class="contribution">
                    <span>My contribution</span>
                    <p>{project.contribution}</p>
                  </div>
                  <ul class="tag-list" aria-label={`${project.title} methods`}>
                    {project.methods.map((method) => <li>{method}</li>)}
                  </ul>
                  <span class="view-project">
                    View project <span aria-hidden="true">↗</span>
                  </span>
                </article>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section page-shell" id="methods">
        <div class="section-heading methods-heading">
          <div>
            <p class="section-label">Methods & tools</p>
            <h2>A mixed-methods researcher with quantitative depth.</h2>
          </div>
          <p>
            My strongest technical foundation is in quantitative behavioral research,
            supported by qualitative and applied evaluation experience.
          </p>
        </div>

        <div class="capability-grid">
          {
            capabilities.map((capability, index) => (
              <article class="capability-card">
                <span class="capability-index">0{index + 1}</span>
                <h3>{capability.title}</h3>
                <p>{capability.text}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section section-dark" id="experience">
        <div class="page-shell experience-grid">
          <div class="experience-intro">
            <p class="section-label section-label-light">Experience</p>
            <h2>Research across academic, nonprofit, and applied settings.</h2>
            <p>
              My work combines independent project ownership with collaboration across
              research teams, community partners, and stakeholders.
            </p>
          </div>

          <div class="timeline">
            {
              experience.map((item) => (
                <article class="timeline-item">
                  <div class="timeline-meta">
                    <span>{item.dates}</span>
                    <span class="timeline-line" aria-hidden="true"></span>
                  </div>
                  <div>
                    <h3>{item.role}</h3>
                    <p class="organization">{item.organization}</p>
                    <p>{item.description}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section page-shell publication-section" id="publications">
        <div>
          <p class="section-label">Selected publication</p>
          <h2>Climate awareness and support for decarbonization</h2>
        </div>

        <article class="publication-card">
          <p class="publication-type">Peer-reviewed journal article</p>
          <p class="citation">
            Khorasgani, F. G., &amp; Tavakoli, M. (2024). Climate change awareness
            and themes of support to decarbonize the economy among students in Iran.
            <em>Journal of Environmental Studies and Sciences</em>, 1–12.
          </p>
          <a
            class="text-link"
            href="https://doi.org/10.1007/s13412-024-00892-7"
            target="_blank"
            rel="noreferrer"
          >
            Read the article <span aria-hidden="true">↗</span>
          </a>
        </article>
      </section>

      <section class="contact-section" id="contact">
        <div class="page-shell contact-grid">
          <div>
            <p class="section-label section-label-light">Let’s connect</p>
            <h2>Interested in applying behavioral research to real-world decisions?</h2>
            <p>
              I am seeking Summer 2027 PhD internships and would be glad to connect
              with teams working in quantitative UX research, behavioral science,
              product research, consumer insights, or related research areas.
            </p>
          </div>

          <div class="contact-actions">
            <a class="contact-link" href="mailto:fatemeh@uoregon.edu">
              <span>Email</span>
              <strong>fatemeh@uoregon.edu</strong>
            </a>
            <a
              class="contact-link"
              href="https://www.linkedin.com/in/fatemeh-ghazavi-khorasgani-265050252"
              target="_blank"
              rel="noreferrer"
            >
              <span>LinkedIn</span>
              <strong>View profile ↗</strong>
            </a>
            <a
              class="contact-link"
              href="https://github.com/fatemeh-khorasgani"
              target="_blank"
              rel="noreferrer"
            >
              <span>GitHub</span>
              <strong>View projects ↗</strong>
            </a>
            <a
              class="contact-link"
              href="https://scholar.google.com/citations?user=7pFvKCwAAAAJ"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Google Scholar</span>
              <strong>View publications ↗</strong>
            </a>
            <a
              class="contact-link"
              href="https://orcid.org/0000-0001-8956-837X"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>ORCID</span>
              <strong>0000-0001-8956-837X ↗</strong>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="page-shell footer-grid">
        <p>© {year} Fatemeh Ghazavi Khorasgani</p>
        <p>Psychology PhD Student · Quantitative Behavioral Researcher</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --navy: #082d38;
    --navy-deep: #051f27;
    --teal: #0b6170;
    --teal-bright: #0f7d8d;
    --teal-soft: #d7edf0;
    --aqua-pale: #eef8f9;
    --gold: #e7ae49;
    --ink: #173038;
    --muted: #5d7077;
    --line: #d4e1e4;
    --surface: #ffffff;
    --background: #f6fafb;
    --shadow: 0 24px 70px rgba(8, 45, 56, 0.12);
    --radius-lg: 28px;
    --radius-md: 18px;
    --page: min(1160px, calc(100% - 40px));
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 88px;
  }

  body {
    margin: 0;
    background: var(--background);
    color: var(--ink);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    font-size: 1rem;
    line-height: 1.65;
    text-rendering: optimizeLegibility;
  }

  a {
    color: inherit;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2,
  h3 {
    color: var(--navy);
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  h1 {
    max-width: 780px;
    margin-bottom: 24px;
    font-size: clamp(3.1rem, 7.4vw, 6.5rem);
  }

  h2 {
    margin-bottom: 24px;
    font-size: clamp(2.2rem, 4.8vw, 4.25rem);
  }

  h3 {
    margin-bottom: 14px;
    font-size: 1.55rem;
  }

  .page-shell {
    width: var(--page);
    margin-inline: auto;
  }

  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 100;
    padding: 10px 14px;
    transform: translateY(-160%);
    border-radius: 8px;
    background: var(--gold);
    color: var(--navy-deep);
    font-weight: 800;
    text-decoration: none;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(5, 31, 39, 0.95);
    backdrop-filter: blur(18px);
  }

  .nav-shell {
    display: flex;
    width: var(--page);
    min-height: 76px;
    margin-inline: auto;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: white;
    font-weight: 800;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 12px;
    background: var(--gold);
    color: var(--navy-deep);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
  }

  .site-header nav {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2.4vw, 30px);
  }

  .site-header nav a {
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.93rem;
    font-weight: 700;
    text-decoration: none;
  }

  .site-header nav a:hover,
  .site-header nav a:focus-visible {
    color: white;
  }

  .hero {
    position: relative;
    overflow: hidden;
    min-height: min(850px, calc(100vh - 76px));
    padding: clamp(76px, 9vw, 118px) 0 clamp(72px, 8vw, 104px);
    background:
      radial-gradient(circle at 82% 14%, rgba(22, 150, 166, 0.18), transparent 30%),
      linear-gradient(135deg, #051f27 0%, #082d38 58%, #0a3f4d 100%);
  }

  .hero-glow {
    position: absolute;
    bottom: -340px;
    left: -260px;
    width: 720px;
    height: 720px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(231, 174, 73, 0.16), transparent 68%);
    pointer-events: none;
  }

  .hero-grid-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    background-image: radial-gradient(rgba(255, 255, 255, 0.28) 0.8px, transparent 0.8px);
    background-size: 28px 28px;
    mask-image: linear-gradient(to right, transparent 8%, black 55%, black 100%);
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(390px, 0.72fr);
    align-items: center;
    gap: clamp(52px, 7vw, 104px);
  }

  .hero-intro-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 22px;
    margin-bottom: 26px;
  }

  .eyebrow,
  .section-label,
  .card-kicker,
  .publication-type {
    margin-bottom: 18px;
    color: var(--teal);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .hero-lede {
    max-width: 680px;
    margin-bottom: 30px;
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(1.08rem, 1.65vw, 1.3rem);
    line-height: 1.7;
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid rgba(143, 211, 220, 0.28);
    border-radius: 999px;
    padding: 7px 12px;
    color: #bce7ec;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .availability-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #72d2bf;
    box-shadow: 0 0 0 4px rgba(114, 210, 191, 0.12);
  }

  .hero .eyebrow {
    margin-bottom: 0;
    color: var(--gold);
  }

  .hero h1 {
    max-width: 760px;
    margin-bottom: 28px;
    color: white;
    font-size: clamp(3.5rem, 6.7vw, 6.35rem);
  }

  .hero h1 em {
    display: block;
    color: #8fd3dc;
    font-weight: 500;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 20px;
  }

  .button {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--navy);
    border-radius: 999px;
    padding: 12px 22px;
    font-weight: 850;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-2px);
  }

  .button-primary {
    border-color: var(--gold);
    background: var(--gold);
    color: var(--navy-deep);
  }

  .button-primary:hover,
  .button-primary:focus-visible {
    border-color: #f3c874;
    background: #f3c874;
  }

  .button-secondary {
    border-color: rgba(255, 255, 255, 0.42);
    background: transparent;
    color: white;
  }

  .button-secondary:hover,
  .button-secondary:focus-visible {
    border-color: white;
    background: rgba(255, 255, 255, 0.08);
  }

  .role-focus {
    max-width: 760px;
    margin-bottom: 0;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .hero-profiles {
    margin-top: 24px;
  }

  .hero-profiles > p {
    margin-bottom: 10px;
    color: rgba(255, 255, 255, 0.48);
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .research-profile-links {
    display: grid;
    max-width: 650px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .research-profile-links a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 11px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 14px;
    padding: 11px 12px;
    background: rgba(255, 255, 255, 0.06);
    color: white;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .research-profile-links a:hover,
  .research-profile-links a:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(143, 211, 220, 0.55);
